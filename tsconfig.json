{
  "compilerOptions": {
    "target": "esnext",
    "module": "commonjs",
    "lib": ["ES2022"],
    "allowJs": true,
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "removeComments": true,
    "preserveConstEnums": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "declaration": true,
    "noEmitOnError": true,
    "sourceMap": true,
    "useDefineForClassFields": true,
    "paths": {
      "@antelopejs/interface-database-catalog/testing": [
        "./node_modules/@antelopejs/interface-database-catalog/dist/testing.d.ts"
      ]
    },
    "types": ["chai", "mocha", "node"]
  },
  "include": ["src/**/*.ts", "src/**/*.js"]
}
