{
  "name": "@antelopejs/rethinkdb",
  "version": "1.5.0",
  "description": "RethinkDB backend for AntelopeJS, implementing the Database and RethinkDB interfaces with rethinkdb-ts",
  "keywords": [
    "antelopejs",
    "database",
    "nosql",
    "realtime",
    "rethinkdb"
  ],
  "homepage": "https://interfaces.antelopejs.com/docs/database",
  "bugs": {
    "url": "https://github.com/AntelopeJS/rethinkdb/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AntelopeJS/rethinkdb.git"
  },
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rimraf dist && tsc",
    "format": "oxfmt .",
    "lint:fix": "oxlint --fix",
    "lint": "oxlint && antelopejs-check-interface-ranges",
    "prepack": "pnpm run build",
    "release": "pnpm run lint && pnpm run test && pnpm run prepack && release-it",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run build && ajs module test . && pnpm run test:external:run",
    "test:external": "pnpm run build && pnpm run test:external:run",
    "test:external:run": "RETHINK_TEST_MODE=external ajs module test . $(for file in dist/test-external/*.test.js; do printf -- '-f %s ' \"$file\"; done)",
    "format:check": "oxfmt --check .",
    "knip": "knip",
    "prepare": "if git rev-parse --is-inside-work-tree >/dev/null 2>&1 && command -v lefthook >/dev/null 2>&1; then lefthook install; fi",
    "checks": "antelopejs-checks",
    "size": "antelopejs-check-size",
    "ratchet": "antelopejs-ratchet",
    "sync": "antelopejs-sync",
    "ratchet:update": "antelopejs-ratchet --update",
    "sync:check": "antelopejs-sync --check",
    "suppressions": "antelopejs-suppressions",
    "suppressions:update": "antelopejs-suppressions --update"
  },
  "dependencies": {
    "@antelopejs/interface-core": ">=0.2.4 <1.0.0",
    "@antelopejs/interface-database": ">=0.2.0 <0.3.0",
    "@antelopejs/interface-database-catalog": ">=0.0.3 <0.1.0",
    "chai": "^4.5.0",
    "reflect-metadata": "^0.2.2",
    "rethinkdb-ts": "^2.7.0"
  },
  "devDependencies": {
    "@antelopejs/core": "^1.16.0",
    "@antelopejs/tooling-configs": "^0.2.11",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.15",
    "@types/semver": "^7.7.1",
    "eslint-plugin-perfectionist": "^5.11.0",
    "knip": "^6.34.0",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "release-it": "^19.2.4",
    "release-it-changelogen": "^0.1.0",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3"
  },
  "optionalDependencies": {
    "@antelopejs/interface-rethinkdb": ">=0.1.0 <0.2.0"
  },
  "packageManager": "pnpm@10.6.5",
  "antelopeJs": {
    "implements": [
      "@antelopejs/interface-database",
      "@antelopejs/interface-database-catalog",
      "@antelopejs/interface-rethinkdb"
    ],
    "test": "src/test/antelope.test.ts",
    "defaultConfig": {
      "pool": {
        "pool": true,
        "cursor": false,
        "silent": true,
        "user": "admin",
        "password": "",
        "discovery": true,
        "host": "127.0.0.1",
        "port": "28015"
      }
    }
  }
}
