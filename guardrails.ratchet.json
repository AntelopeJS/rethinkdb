{
  "pack": "0.2.17",
  "rules": {
    "antelopejs/no-inherited-key-lookup": 16,
    "anti-slop/no-known-value-widening": 5,
    "anti-slop/require-safety-comment-for-type-assertion": 5,
    "typescript/no-unsafe-argument": 42,
    "typescript/no-unsafe-assignment": 75,
    "typescript/no-unsafe-return": 17,
    "typescript/use-unknown-in-catch-callback-variable": 3
  },
  "oversizeFiles": {}
}
